# Copy to .env and fill in. Never commit the real .env.

# From the API Keys page of your Console Settings:
# https://console.cloudinary.com/app/settings/api-keys
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# The campaign tag to publish.
CAMPAIGN=summer-campaign

# Comma-separated addresses allowed to open the public page.
SHARE_EMAILS=reviewer@agency.example,art-director@agency.example
